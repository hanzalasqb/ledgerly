{
  "name": "ledgerly",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @ledgerly/api & npm run dev -w @ledgerly/web",
    "dev:demo": "npm run dev:demo -w @ledgerly/web",
    "build": "npm run build -w @ledgerly/api && npm run build -w @ledgerly/web",
    "test": "npm test -w @ledgerly/api",
    "typecheck": "tsc -p apps/api && tsc -p apps/web",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "engines": { "node": ">=22.13" }
}
